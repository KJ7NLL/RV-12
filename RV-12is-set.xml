<PropertyList>
    <sim>
        <author>KJ7NLL (Clash), POLSKY1, Phoenix</author>
        <expected-aircraft-dir-name>RV-12</expected-aircraft-dir-name>
        <description>RV-12</description>
        <long-description>
            The RV-12is is the fuel injected version of the RV-12uls. It is a homebuilt aircraft developed by Van's aircraft that is routinely built by teens around the world.
        </long-description>
        <status>alpha</status>
        <rating>
            <FDM type="int">1</FDM>
            <systems type="int">3</systems>
            <cockpit type="int">2</cockpit>
            <model type="int">2</model>
        </rating>
        <flight-model>jsb</flight-model>
        <aero>RV-12is-jsbsim</aero>
        <model>
            <path>Aircraft/RV-12/Models/RV-12is.xml</path>
        </model>
        <view>
            <name>Cockpit View</name>
            <type>lookfrom</type>
            <internal type="bool">true</internal>
            <config>
                <from-model type="bool">true</from-model>
                <from-model-idx type="int">0</from-model-idx>
                <x-offset-m type="double">-0.225203 m</x-offset-m>
                <y-offset-m type="double">1.5</y-offset-m>
                <z-offset-m type="double">-0.063249 m</z-offset-m>
            </config>
        </view>
        <multiplay>
            <generic>
            <float n="5" type="float" alias="/surface-positions/elevator-pos-norm"/>		
            <float n="6" type="float" alias="/surface-positions/rudder-pos-norm"/>	
            <float n="7" type="float" alias="/surface-positions/left-aileron-pos-norm"/>	
            <float n="8" type="float" alias="/surface-positions/right-aileron-pos-norm"/>	
            <float n="9" type="float" alias="/surface-positions/flap-pos-norm"/>	
            </generic>
        </multiplay>

		<systems>
			<electrical>
				<path>Aircraft/RV-12/Systems/battery.xml</path>
			</electrical>
			<!--
			<autopilot>
			   <path>Aircraft/RV-12/Systems/Autopilot.xml</path>
			</autopilot>
			-->
		</systems>
        <previews>
            <preview>
                <type>exterior</type>
                <path>Splashes/thumbnail.jpg</path>
                <splash type="bool">true</splash>
            </preview>
        </previews>

        <startup>
			<splash-texture>Aircraft/RV-12/thumbnail.jpg</splash-texture>
		</startup>
    </sim>
    <input>
        <keyboard>
            <key n="115">
    <name>s</name>
  <desc></desc>
	<binding>
		<command>nasal</command>
		<script>switches.starter();</script>
	</binding>
  <mod-up>
    <binding>
      <command>nasal</command>
      <script>setprop("controls/engines/engine/starter",0);</script>
    </binding>
  </mod-up>
 </key>
		</keyboard>
	</input>
    <nasal>
        <startup>
            <file>Nasal/startup.nas</file>
        </startup>
        <switches>
            <file>Nasal/switch.nas</file>
        </switches>
        <rain>
            <file>Nasal/rain.nas</file>
        </rain>
    </nasal>

</PropertyList>
