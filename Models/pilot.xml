<?xml version="1.0"?>

<PropertyList>

<path>pilot.ac</path>

    <animation>
        <type>select</type>
        <object-name>glasses</object-name>
        <object-name>headset</object-name>
        <object-name>Head</object-name>
        <object-name>Torso.001</object-name>
        <object-name>Rarm.001</object-name>
        <object-name>Larm.001</object-name>
        <object-name>Rforearm.001</object-name>
        <object-name>Lforearm.001</object-name>
        <object-name>Rhand</object-name>
        <object-name>Lhand</object-name>
        <object-name>Pelvis.001</object-name>
        <object-name>Rthigh.001</object-name>
        <object-name>Lthigh.001</object-name>
        <object-name>Rcalf.001</object-name>
        <object-name>Lcalf.001</object-name>
        <object-name>Rfoot</object-name>
        <object-name>Lfoot</object-name>
        <condition>
            <not>
                <property>sim/current-view/internal</property>
            </not>
        </condition>
 </animation>

    <animation>
        <type>rotate</type>
        <object-name>Head</object-name>
        <object-name>headset</object-name>
        <object-name>glasses</object-name>
        <property>rv-12/head-hdg-deg</property>
        <factor>1</factor>
        <center>
            <x-m>-0.002369</x-m>
            <y-m>-0.264578</y-m>
            <z-m>1.40608</z-m>
        </center>
        <axis>
            <x>0.0</x>
            <y>0.0</y>
            <z>1.0</z>
        </axis>
    </animation>
    <animation>
        <type>rotate</type>
        <object-name>Head</object-name>
        <object-name>headset</object-name>
        <object-name>glasses</object-name>
        <property>rv-12/head-ptc-deg</property>
        <factor>1</factor>
        <center>
            <x-m>-0.002369</x-m>
            <y-m>-0.264578</y-m>
            <z-m>1.40608</z-m>
        </center>
        <axis>
            <x>0.0</x>
            <y>1.0</y>
            <z>0.0</z>
        </axis>
    </animation>

</PropertyList>